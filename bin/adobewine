#!/usr/bin/env bash
# LinDobe launcher.
#   adobewine setup [--windows-fonts DIR] [--dpi N]  create or refresh the Wine prefix (run once)
#   adobewine <app> [files...]              open a supported Adobe app
#   adobewine run <program.exe> [args...]     run any Windows program in the LinDobe prefix
#   adobewine off [--force]                   close the Adobe apps like their close button, then stop Wine
#   adobewine fix-signin                      use the built-in browser for Adobe sign-in (see docs)
#   adobewine launchers [--remove]            add the installed apps to the desktop menu
#   adobewine report [--note "..."]           send a problem report (you see it first)
#   adobewine winecfg|regedit|shell           Wine tools for this prefix
source "$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/bin/env.sh"
source "$ADOBEWINE_SRC/bin/app-catalog.sh"
use_ie_licensing() {  # Adobe's Chromium licensing window draws nothing under Wine; without it Adobe uses the IE one
  local f r=1
  for f in "$WINEPREFIX/drive_c/Program Files"*"/Common Files/Adobe/Adobe Desktop Common/NGL/adobe_licensing_wf.exe"; do
    [ -f "$f" ] && mv -f "$f" "$f.disabled" && r=0
  done
  return $r
}
photoshop_wintab() {  # Photoshop reads a pen through WinTab (pressure) only with "UseSystemStylus 0"; with Windows
  # Ink, its default, a pen under Wine draws without pressure. Added unless the user has their own line. From Neutron
  # (ensure_photoshop_wintab, LGPL-2.1), measured there on a Cintiq 22HD.
  local name="$1" u f
  for u in "$WINEPREFIX/drive_c/users/"*/; do
    [ "$(basename "$u")" = Public ] && continue
    f="$u/AppData/Roaming/Adobe/$name/$name Settings/PSUserConfig.txt"
    grep -qiE '^[[:space:]]*UseSystemStylus\b' "$f" 2>/dev/null && continue
    mkdir -p "$(dirname "$f")" || continue
    { [ -s "$f" ] && [ -n "$(tail -c1 "$f")" ] && printf '\r\n'
      printf '# LinDobe: read the pen through WinTab (pressure, tilt, eraser)\r\nUseSystemStylus 0\r\n'; } >> "$f"
  done
}
cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  run)         exe="$1"; shift ;;
  setup)       exec "$ADOBEWINE_SRC/scripts/setup-prefix.sh" "$@" ;;
  launchers)   exec "$ADOBEWINE_SRC/scripts/install-launchers.sh" "$@" ;;
  report)      exec "$ADOBEWINE_SRC/scripts/report.sh" "$@" ;;
  winecfg|regedit) exec wine "$cmd" ;;
  shell)       exec bash --rcfile <(echo "source '$ADOBEWINE_SRC/bin/env.sh'; PS1='(adobewine) \\w \$ '") ;;
  off)
    if [ "${1:-}" != --force ]; then
      W="$ADOBEWINE_SRC/lib/winclose.exe"
      [ -f "$W" ] || W="$ADOBEWINE_HOME/winclose.exe"
      [ -f "$W" ] || x86_64-w64-mingw32-gcc -O2 -o "$W" "$ADOBEWINE_SRC/tools/winclose/winclose.c"
      declare -A close_names=()
      while IFS='|' read -r command _ _ program _; do
        [ "$command" = cc ] && continue
        name="${program##*/}"
        close_names["${name,,}"]="$name"
      done < "$ADOBE_APP_CATALOG"
      wine "$W" "${close_names[@]}" >/dev/null 2>&1
      apps=$(printf '%s\n' "${close_names[@]}" | sed 's/[][\.^$*+?(){}|]/\\&/g' | paste -sd '|')
      apps="^($apps)"
      for _ in $(seq 60); do wine tasklist 2>/dev/null | grep -qiE "$apps" || break; sleep 1; done
      if wine tasklist 2>/dev/null | grep -qiE "$apps"; then
        echo "An Adobe app is still open (maybe asking to save). Close it, or run: adobewine off --force"; exit 1
      fi
    fi
    wineserver -k; echo "All LinDobe processes stopped."; exit 0 ;;
  fix-signin)
    # Adobe's licensing window comes in two flavours; the Chromium one does not draw under
    # Wine, the Internet Explorer engine one does. Renaming the Chromium helper makes Adobe's
    # sign-in library fall back to the IE one. Your sign-in and licence are unchanged.
    use_ie_licensing && echo "done" || echo "nothing to do (helper not present or already renamed)"
    exit 0 ;;
  ""|-h|--help)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    printf 'Apps: %s\n' "$(cut -d'|' -f1 "$ADOBE_APP_CATALOG" | paste -sd '|')"
    exit 0 ;;
  *)
    exe=
    while IFS='|' read -r command _ folder program _; do
      [ "$cmd" = "$command" ] || continue
      folder="$(app_folder "$folder")"
      path="$folder/$program"
      [ "$cmd" = photoshop ] && photoshop_wintab "$folder"
      exe="C:\\Program Files\\Adobe\\${path//\//\\}"
      break
    done < "$ADOBE_APP_CATALOG"
    if [ -z "$exe" ]; then
      echo "unknown command: $cmd (try adobewine --help)" >&2
      exit 1
    fi ;;
esac
# Creative Cloud restores the helper when it updates itself, so this runs at every start.
use_ie_licensing || true
# Linux paths (from a file manager or a .desktop %F) become Windows paths.
args=()
for a in "$@"; do
  if [ -e "$a" ]; then args+=("Z:$(realpath "$a" | sed 's|/|\\|g')"); else args+=("$a"); fi
done
# Creative Cloud (Chromium): with GPU vsync a page change can stay off screen until a repaint.
[ "$cmd" = cc ] && args=(--disable-gpu-vsync "${args[@]}")
# An app that "closed" but did not exit (no window, process still there) would take this launch
# through its single-instance check and nothing would open. Give it 10 s to finish exiting; if it
# is still there without a window, end only that exe.
name="${exe##*\\}"
if [ "$cmd" != run ] && wine tasklist 2>/dev/null | grep -qiF "$name"; then
  for _ in $(seq 10); do wine tasklist 2>/dev/null | grep -qiF "$name" || break; sleep 1; done
  if wine tasklist 2>/dev/null | grep -qiF "$name"; then
    # Does it still have a window? (python-xlib; without it, only warn)
    has_win=$(python3 -c "
import sys
from Xlib import display
d = display.Display()
n = 0
for w in d.screen().root.query_tree().children:
    try:
        c = w.get_wm_class()
        n += bool(c and c[1].lower() == sys.argv[1].lower() and w.get_attributes().map_state == 2)
    except Exception:
        pass
print(n)" "$name" 2>/dev/null)
    if [ "$has_win" = 0 ]; then
      wine taskkill /f /im "$name" >/dev/null 2>&1
      echo "A previous ${name%.exe} was stuck closing (no window); ended it."
    elif [ -z "$has_win" ]; then
      echo "${name%.exe} is still running. If nothing opens, it may be stuck closing: adobewine off"
    fi
  fi
fi
# Adobe's core fonts (Myriad Pro, Minion Pro) live in Common Files\Adobe\Fonts on Windows, where
# exports that look fonts up by name (Illustrator's PSD text layers, SVG fonts) find them. The
# installers do not create it under Wine, so those exports fell back to Times New Roman. Fill it
# from an installed app's own Required/Fonts.
core_fonts() {
  local d="$WINEPREFIX/drive_c/Program Files/Common Files/Adobe/Fonts"
  [ -f "$d/MyriadPro-Regular.otf" ] && return
  find "$WINEPREFIX/drive_c/Program Files/Adobe" -path '*/Required/Fonts/*' \( -iname 'MyriadPro-*.otf' -o -iname 'MinionPro-*.otf' \) 2>/dev/null |
    while read -r f; do mkdir -p "$d"; cp -n "$f" "$d/"; done
}
core_fonts
# Premiere on AMD: the GPU path known to work is AMD's OpenCL. A Flatpak sandbox can't see the host's driver files.
if [ "$cmd" = premiere ] && [ ! -e /.flatpak-info ] && [ ! -e /proc/driver/nvidia/version ] &&
   grep -qs 0x1002 /sys/class/drm/card[0-9]/device/vendor && ! ls /etc/OpenCL/vendors/amdocl*.icd >/dev/null 2>&1; then
  echo "AMD GPU without AMD's OpenCL driver: Premiere may scrub black frames. Install rocm-opencl-runtime (see Troubleshooting)."
fi
# Video memory: NVIDIA on Linux refuses an allocation the GPU has no room for (Windows moves other memory out of the
# way instead), so with the GPU nearly full Premiere's panels come up blank or stale and exports fail with a GPU render
# error. Premiere alone grows to about 5 GB; Media Encoder keeps over 1 GB after an export.
gpu_note() {
  command -v nvidia-smi >/dev/null || return
  local free; free=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | head -1)
  [ -n "$free" ] && [ "$free" -lt 3000 ] 2>/dev/null || return
  local users; users=$(nvidia-smi --query-compute-apps=process_name,used_memory --format=csv,noheader 2>/dev/null |
    sed 's#.*[\\/]##' | sort -t, -k2 -rn | head -3 | paste -sd ';' | sed 's/;/; /g')
  echo "Only $free MiB of video memory is free (${users:-other programs}). Panels may stay blank and exports may fail; close what you don't need."
}
case "$cmd" in premiere|aftereffects|encoder) gpu_note ;; esac
log="$ADOBEWINE_HOME/logs/$cmd-$(date +%Y%m%d-%H%M%S).log"
echo "log: $log"
start=$SECONDS
wine "$exe" "${args[@]}" > "$log" 2>&1
rc=$?
if [ "$(grep -c 'Failed to create Vulkan swapchain' "$log" 2>/dev/null)" -gt 20 ]; then
  echo "$cmd could not create some of its panels: the GPU was out of video memory. Closing other GPU programs (Media Encoder too) helps."
fi
# After a crash: offer a report (REPORTS=ask, the default), send it (REPORTS=auto) or do
# nothing (REPORTS=off), as set in ~/.config/adobewine/config.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/adobewine/config"
REPORTS=ask; [ -f "$conf" ] && source "$conf"
if [ "$REPORTS" != off ] && grep -qE 'Unhandled exception|Unhandled page fault|page fault on' "$log"; then
  r=("$ADOBEWINE_SRC/scripts/report.sh" --app "$cmd" --log "$log" --exit-code "$rc" --duration $((SECONDS - start)))
  if [ "$REPORTS" = auto ]; then "${r[@]}" --auto >/dev/null 2>&1
  elif [ -t 0 ]; then echo "$cmd crashed."; "${r[@]}"
  else "${r[@]}" --save-only >/dev/null 2>&1
       command -v notify-send >/dev/null && notify-send -i dialog-warning "LinDobe: $cmd crashed" \
         "A report was saved. Run 'adobewine report' in a terminal to review and send it."
  fi
fi
exit $rc
