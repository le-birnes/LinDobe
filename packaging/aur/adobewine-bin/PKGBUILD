# Maintainer: LinDobe contributors (see https://github.com/le-birnes/LinDobe)
pkgname=adobewine-bin
pkgver=0.6.1
pkgrel=1
pkgdesc="LinDobe (prebuilt): Wine 11.20 with patches for Adobe Creative Cloud apps (Photoshop, Illustrator, Premiere Pro, Audition, Media Encoder)"
arch=(x86_64)
url="https://github.com/le-birnes/LinDobe"
license=(LGPL-2.1-or-later)
provides=(adobewine)
conflicts=(adobewine)
options=(!strip !debug)
depends=(
  desktop-file-utils shared-mime-info fontconfig freetype2 libgcc gettext glib2 glibc libpcap libunwind
  libx11 libxcursor libxext libxkbcommon libxi libxrandr systemd-libs wayland
  vulkan-icd-loader gnutls alsa-lib libpulse gst-plugins-base-libs winetricks curl
)
optdepends=(
  'gst-plugins-good: MP4/MKV media in Premiere Pro, Audition and Media Encoder'
  'gst-plugins-bad: more media formats'
  'gst-libav: more media formats'
  'nvidia-utils: NVIDIA GPU (CUDA, NVENC through nvidia-libs)'
  'vulkan-intel: Intel GPU'
  'vulkan-radeon: AMD GPU'
  'p7zip: application icons for the desktop menu entries'
  'python-pillow: application icons for the desktop menu entries'
)
source=("${url}/releases/download/v${pkgver}/adobewine-${pkgver}-x86_64.tar.zst")
sha256sums=('eca2861c0f4aa6afb9f58982c2a54fae1db4f8e84e8a6559c2a244c7e4064779')

package() {
  cp -a "$srcdir/opt" "$pkgdir/"
  install -d "$pkgdir/usr/bin"
  ln -s /opt/adobewine/bin/adobewine "$pkgdir/usr/bin/adobewine"
  install -Dm644 "$pkgdir/opt/adobewine/README.md" "$pkgdir/usr/share/doc/adobewine/README.md"
  install -Dm644 "$pkgdir/opt/adobewine/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
