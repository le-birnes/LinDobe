+static BOOL has_layered_children( HWND hwnd )
+{
+    WND *win = get_win_ptr( hwnd );
+    BOOL ret;
+
+    if (!win || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return FALSE;
+    ret = !!(win->flags & WIN_LAYERED_CHILDREN);
+    release_win_ptr( win );
+    return ret;
+}
+
+static void mark_layered_ancestors( HWND hwnd )
+{
+    WND *win;
+
+    for (; hwnd && hwnd != NtUserGetDesktopWindow(); hwnd = NtUserGetAncestor( hwnd, GA_PARENT ))
+    {
+        if (!(win = get_win_ptr( hwnd )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) continue;
+        win->flags |= WIN_LAYERED_CHILDREN;
+        release_win_ptr( win );
+    }
+}
