+static void update_layered_children( HWND hwnd )
+{
+    HWND *children = list_window_children( hwnd );
+    unsigned int i;
+
+    if (!children) return;
+    for (i = 0; children[i]; i++)
+    {
+        COLORREF key;
+        DWORD flags;
+        BYTE alpha;
+
+        if ((NtUserGetWindowLongW( children[i], GWL_EXSTYLE ) & WS_EX_LAYERED) &&
+            NtUserGetLayeredWindowAttributes( children[i], &key, &alpha, &flags ) &&
+            flags == LWA_ALPHA && alpha == 255)
+        {
+            update_window_state( children[i] );
+            NtUserRedrawWindow( children[i], NULL, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME );
+        }
+        update_layered_children( children[i] );
+    }
+    free( children );
+}
