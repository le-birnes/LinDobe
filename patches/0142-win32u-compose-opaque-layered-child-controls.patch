     RECT dirty = surface->rect, bounds;
     BOOL flushed = FALSE;
-    void *color_bits;
+    void *color_bits, *composed = NULL;
+    struct list children = LIST_INIT( children );
+    struct window_rects rects;
+    struct layered_child *child;
+
+    /* Window position updates take the user lock before a surface lock. */
+    if (compose && surface->hwnd && is_composition_surface( surface ) &&
+        get_window_rects( surface->hwnd, COORDS_SCREEN, &rects, get_dpi_for_window( surface->hwnd ) ))
+        collect_layered_children( surface->hwnd, get_dpi_for_window( surface->hwnd ), &rects.client, &children );
 
     window_surface_lock( surface );
 
@@ -649,8 +806,19 @@
 
     if (intersect_rect( &dirty, &dirty, &bounds ) && (color_bits = window_surface_get_color( surface, color_info )))
     {
-        BOOL shape_changed = update_surface_shape( surface, &surface->rect, &dirty, color_info, color_bits );
-        void *shape_bits = window_surface_get_shape( surface, shape_info );
+        BOOL shape_changed;
+        void *shape_bits;
+
+        if (surface->alpha_mask && !list_empty( &children ) && color_info->bmiHeader.biBitCount == 32 &&
+            (composed = malloc( color_info->bmiHeader.biSizeImage )))
+        {
+            memcpy( composed, color_bits, color_info->bmiHeader.biSizeImage );
+            LIST_FOR_EACH_ENTRY( child, &children, struct layered_child, entry )
+                compose_layered_child( child, surface, &rects, color_info, composed );
+            color_bits = composed;
+        }
+        shape_changed = update_surface_shape( surface, &surface->rect, &dirty, color_info, color_bits );
+        shape_bits = window_surface_get_shape( surface, shape_info );
 
         TRACE( "Flushing hwnd %p, surface %p %s, bounds %s, dirty %s\n", surface->hwnd, surface,
                wine_dbgstr_rect( &surface->rect ), wine_dbgstr_rect( &surface->bounds ), wine_dbgstr_rect( &dirty ) );
@@ -664,8 +832,18 @@
     }
 
     window_surface_unlock( surface );
-
-    if (flushed && surface->hwnd) present_offscreen_client_surfaces( NtUserGetAncestor( surface->hwnd, GA_ROOT ) );
+    free( composed );
+    free_layered_children( &children );
+
+    if (compose && flushed && surface->hwnd && surface->funcs == &offscreen_window_surface_funcs)
+        refresh_window_surface( NtUserGetAncestor( surface->hwnd, GA_PARENT ) );
+
+    if (compose && flushed && surface->hwnd) present_offscreen_client_surfaces( NtUserGetAncestor( surface->hwnd, GA_ROOT ) );
+}
+
+void window_surface_flush( struct window_surface *surface )
+{
+    flush_window_surface( surface, TRUE );
 }
 
 void window_surface_set_layered( struct window_surface *surface, COLORREF color_key, UINT alpha_bits, UINT alpha_mask )
@@ -730,7 +908,7 @@
     window_surface_unlock( surface );
 }
 
-void window_surface_set_shape( struct window_surface *surface, HRGN shape_region )
+static void set_window_surface_shape( struct window_surface *surface, HRGN shape_region, BOOL flush )
 {
     window_surface_lock( surface );
 
@@ -749,7 +927,12 @@
 
     window_surface_unlock( surface );
 
-    window_surface_flush( surface );
+    if (flush) window_surface_flush( surface );
+}
+
+void window_surface_set_shape( struct window_surface *surface, HRGN shape_region )
+{
+    set_window_surface_shape( surface, shape_region, TRUE );
 }
 
