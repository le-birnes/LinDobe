-void window_surface_flush( struct window_surface *surface )
+static BOOL is_composition_surface( struct window_surface *surface )
+{
+    WND *win = get_win_ptr( surface->hwnd );
+    BOOL ret;
+
+    if (!win || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return FALSE;
+    ret = win->surface == surface && (win->flags & WIN_LAYERED_CHILDREN);
+    release_win_ptr( win );
+    return ret;
+}
+
+struct layered_child
+{
+    struct list entry;
+    struct window_surface *surface;
+    RECT rect;
+    RECT clip;
+};
+
+static void collect_layered_children( HWND parent, struct ratio dpi, const RECT *clip, struct list *list )
+{
+    HWND *children = list_window_children( parent );
+    unsigned int count = 0;
+
+    if (!children) return;
+    while (children[count]) count++;
+    while (count)
+    {
+        HWND hwnd = children[--count];
+        struct window_surface *surface = NULL;
+        struct window_rects rects;
+        struct layered_child *child;
+        RECT visible, child_clip;
+        WND *win;
+
+        if (!is_window_visible( hwnd ) || !get_window_rects( hwnd, COORDS_SCREEN, &rects, dpi )) continue;
+        if (!intersect_rect( &visible, &rects.visible, clip )) continue;
+        if ((win = get_win_ptr( hwnd )) && win != WND_DESKTOP && win != WND_OTHER_PROCESS)
+        {
+            if ((surface = win->surface)) window_surface_add_ref( surface );
+            release_win_ptr( win );
+        }
+        if (surface && surface->funcs == &offscreen_window_surface_funcs &&
+            (child = malloc( sizeof(*child) )))
+        {
+            child->surface = surface;
+            child->rect = rects.visible;
+            child->clip = visible;
+            list_add_tail( list, &child->entry );
+        }
+        else if (surface) window_surface_release( surface );
+        if (intersect_rect( &child_clip, &rects.client, clip ))
+            collect_layered_children( hwnd, dpi, &child_clip, list );
+    }
+    free( children );
+}
+
+static void free_layered_children( struct list *list )
+{
+    struct layered_child *child, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( child, next, list, struct layered_child, entry )
+    {
+        list_remove( &child->entry );
+        window_surface_release( child->surface );
+        free( child );
+    }
+}
+
+static void compose_layered_child( struct layered_child *child, struct window_surface *target,
+                                   const struct window_rects *target_rects, const BITMAPINFO *target_info,
+                                   UINT32 *target_bits )
+{
+    struct window_surface *surface = child->surface;
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    const UINT32 *bits;
+    int target_stride = target_info->bmiHeader.biWidth;
+    int x, y, source_x, source_y, dest_x, dest_y;
+
+    window_surface_lock( surface );
+    bits = window_surface_get_color( surface, info );
+    if (!bits || info->bmiHeader.biBitCount != 32) goto done;
+    for (y = child->clip.top; y < child->clip.bottom; y++)
+    {
+        source_y = y - child->rect.top - surface->rect.top;
+        dest_y = y - target_rects->visible.top - target->rect.top;
+        if (source_y < 0 || source_y >= -info->bmiHeader.biHeight ||
+            dest_y < 0 || dest_y >= -target_info->bmiHeader.biHeight) continue;
+        for (x = child->clip.left; x < child->clip.right; x++)
+        {
+            source_x = x - child->rect.left - surface->rect.left;
+            dest_x = x - target_rects->visible.left - target->rect.left;
+            if (source_x < 0 || source_x >= info->bmiHeader.biWidth ||
+                dest_x < 0 || dest_x >= target_stride) continue;
+            if (surface->clip_region && !NtGdiPtInRegion( surface->clip_region,
+                x - child->rect.left, y - child->rect.top )) continue;
+            target_bits[dest_y * target_stride + dest_x] =
+                bits[source_y * info->bmiHeader.biWidth + source_x] | 0xff000000;
+        }
+    }
+done:
+    window_surface_unlock( surface );
+}
+
+
+void refresh_window_surface( HWND hwnd )
+{
+    struct window_surface *surface;
+    WND *win;
+
+    for (; hwnd && hwnd != NtUserGetDesktopWindow(); hwnd = NtUserGetAncestor( hwnd, GA_PARENT ))
+    {
+        if (!(win = get_win_ptr( hwnd )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) continue;
+        if ((surface = win->surface)) window_surface_add_ref( surface );
+        release_win_ptr( win );
+        if (!surface) continue;
+        if (surface != &dummy_surface)
+        {
+            window_surface_lock( surface );
+            surface->bounds = surface->rect;
+            window_surface_unlock( surface );
+            window_surface_flush( surface );
+            window_surface_release( surface );
+            break;
+        }
+        window_surface_release( surface );
+    }
+}
+
+
+static void flush_window_surface( struct window_surface *surface, BOOL compose )
 {
     char color_buf[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
     char shape_buf[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
@@ -635,7 +784,15 @@
