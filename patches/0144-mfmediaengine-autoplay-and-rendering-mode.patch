+/* Rendering mode (MF_MEDIA_ENGINE_PLAYBACK_HWND): Windows draws the video into the window itself. Photoshop's UXP
+ * <video> (What's New, in-app tips) creates its engine this way, with no output format, so the video stayed blank.
+ * Present the frame due at the presentation clock with GDI, aspect-fitted to the client area. */
+static DWORD CALLBACK render_thread_proc(void *arg)
+{
+    struct media_engine *engine = arg;
+    LONGLONG last_pts = MINLONGLONG, pts;
+    DWORD last_draw = 0;
+    BYTE *bits = NULL;
+    SIZE size = {0};
+    LONG stride_hint = 0;
+
+    SetThreadDescription(GetCurrentThread(), L"wine_mfmediaengine_render");
+
+    while (!engine->render_stop)
+    {
+        BOOL draw = FALSE;
+        MFTIME clocktime;
+
+        Sleep(10);
+        EnterCriticalSection(&engine->cs);
+        if (engine->flags & FLAGS_ENGINE_SHUT_DOWN)
+        {
+            LeaveCriticalSection(&engine->cs);
+            break;
+        }
+        if (engine->presentation.frame_sink && engine->video_frame.size.cx && engine->video_frame.size.cy)
+        {
+            IMFSample *sample = NULL;
+            pts = MINLONGLONG;
+            if (SUCCEEDED(IMFPresentationClock_GetTime(engine->clock, &clocktime)))
+                video_frame_sink_get_pts(engine->presentation.frame_sink, clocktime, &pts);
+            if ((pts != last_pts || GetTickCount() - last_draw > 250)
+                    && video_frame_sink_get_sample(engine->presentation.frame_sink, &sample))
+            {
+                IMFMediaBuffer *buffer;
+                IMF2DBuffer *buffer2d;
+                BYTE *data;
+                LONG pitch;
+                DWORD len;
+                int y;
+
+                /* The decoded frames can differ from the source's frame size (the topology may scale, or the
+                 * decoder may pad): take size and stride from the sink's negotiated type. */
+                {
+                    SIZE cur = engine->video_frame.size;
+                    IMFStreamSink *stream;
+                    IMFMediaTypeHandler *handler;
+                    IMFMediaType *type;
+                    UINT64 frame_size;
+                    UINT32 stride;
+
+                    stride_hint = 0;
+                    if (SUCCEEDED(video_frame_sink_query_iface(engine->presentation.frame_sink, &IID_IMFStreamSink, (void **)&stream)))
+                    {
+                        if (SUCCEEDED(IMFStreamSink_GetMediaTypeHandler(stream, &handler)))
+                        {
+                            if (SUCCEEDED(IMFMediaTypeHandler_GetCurrentMediaType(handler, &type)))
+                            {
+                                if (SUCCEEDED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_SIZE, &frame_size)) && frame_size)
+                                {
+                                    cur.cx = frame_size >> 32;
+                                    cur.cy = (UINT32)frame_size;
+                                }
+                                if (SUCCEEDED(IMFMediaType_GetUINT32(type, &MF_MT_DEFAULT_STRIDE, &stride)))
+                                    stride_hint = (INT32)stride;
+                                IMFMediaType_Release(type);
+                            }
+                            IMFMediaTypeHandler_Release(handler);
+                        }
+                        IMFStreamSink_Release(stream);
+                    }
+                    if (size.cx != cur.cx || size.cy != cur.cy)
+                    {
+                        size = cur;
+                        free(bits);
+                        bits = malloc(size.cx * size.cy * 4);
+                    }
+                }
+                if (bits && SUCCEEDED(IMFSample_GetBufferByIndex(sample, 0, &buffer)))
+                {
+                    if (SUCCEEDED(IMFMediaBuffer_QueryInterface(buffer, &IID_IMF2DBuffer, (void **)&buffer2d)))
+                    {
+                        if (SUCCEEDED(IMF2DBuffer_Lock2D(buffer2d, &data, &pitch)))
+                        {
+                            for (y = 0; y < size.cy; y++)
+                                memcpy(bits + y * size.cx * 4, data + y * pitch, size.cx * 4);
+                            IMF2DBuffer_Unlock2D(buffer2d);
+                            draw = TRUE;
+                        }
+                        IMF2DBuffer_Release(buffer2d);
+                    }
+                    else if (SUCCEEDED(IMFMediaBuffer_Lock(buffer, &data, NULL, &len)))
+                    {
+                        LONG row = abs(stride_hint) >= size.cx * 4 ? abs(stride_hint) : size.cx * 4;
+
+                        /* RGB with no stride in its type is bottom-up, as for a DIB */
+                        if (!stride_hint) stride_hint = -row;
+                        if (len >= row * size.cy)
+                        {
+                            for (y = 0; y < size.cy; y++)
+                                memcpy(bits + y * size.cx * 4, data + (stride_hint < 0 ? size.cy - 1 - y : y) * row, size.cx * 4);
+                            draw = TRUE;
+                        }
+                        else WARN("Sample of %lu bytes for %ldx%ld.\n", len, size.cx, size.cy);
+                        IMFMediaBuffer_Unlock(buffer);
+                    }
+                    IMFMediaBuffer_Release(buffer);
+                }
+                IMFSample_Release(sample);
+                last_pts = pts;
+            }
+        }
+        LeaveCriticalSection(&engine->cs);
+
+        if (draw)
+        {
+            BITMAPINFO bmi = {{sizeof(BITMAPINFOHEADER)}};
+            RECT rc;
+            HDC hdc;
+
+            last_draw = GetTickCount();
+            if (!IsWindowVisible(engine->playback_hwnd) || !GetClientRect(engine->playback_hwnd, &rc)
+                    || rc.right <= 0 || rc.bottom <= 0 || !(hdc = GetDC(engine->playback_hwnd)))
+                continue;
+            bmi.bmiHeader.biWidth = size.cx;
+            bmi.bmiHeader.biHeight = -size.cy;    /* RGB32 samples are top-down */
+            bmi.bmiHeader.biPlanes = 1;
+            bmi.bmiHeader.biBitCount = 32;
+            bmi.bmiHeader.biCompression = BI_RGB;
+            {
+                LONG w = rc.right, h = MulDiv(rc.right, size.cy, size.cx), x = 0, yy;
+                if (h > rc.bottom) { h = rc.bottom; w = MulDiv(rc.bottom, size.cx, size.cy); }
+                x = (rc.right - w) / 2; yy = (rc.bottom - h) / 2;
+                SetStretchBltMode(hdc, HALFTONE);
+                StretchDIBits(hdc, x, yy, w, h, 0, 0, size.cx, size.cy, bits, &bmi, DIB_RGB_COLORS, SRCCOPY);
+            }
+            ReleaseDC(engine->playback_hwnd, hdc);
+        }
+    }
+    free(bits);
+    return 0;
+}
