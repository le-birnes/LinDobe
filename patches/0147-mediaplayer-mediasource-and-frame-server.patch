+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mediaplayer);
+
+static LONG64 next_token;
+
+HRESULT event_handlers_add( struct event_handlers *list, CRITICAL_SECTION *cs, IUnknown *handler, EventRegistrationToken *token )
+{
+    HRESULT hr = E_OUTOFMEMORY;
+    UINT i;
+
+    if (!handler || !token) return E_INVALIDARG;
+    EnterCriticalSection( cs );
+    for (i = 0; i < MAX_EVENT_HANDLERS; i++)
+    {
+        if (list->handler[i]) continue;
+        list->handler[i] = handler;
+        IUnknown_AddRef( handler );
+        token->value = list->token[i] = InterlockedIncrement64( &next_token );
+        hr = S_OK;
+        break;
+    }
+    LeaveCriticalSection( cs );
+    return hr;
+}
+
+HRESULT event_handlers_remove( struct event_handlers *list, CRITICAL_SECTION *cs, EventRegistrationToken token )
+{
+    IUnknown *handler = NULL;
+    UINT i;
+
+    EnterCriticalSection( cs );
+    for (i = 0; i < MAX_EVENT_HANDLERS; i++)
+    {
+        if (!list->handler[i] || list->token[i] != token.value) continue;
+        handler = list->handler[i];
+        list->handler[i] = NULL;
+        break;
+    }
+    LeaveCriticalSection( cs );
+    if (handler) IUnknown_Release( handler );
+    return S_OK;
+}
+
+typedef HRESULT (WINAPI *delegate_invoke)( IUnknown *iface, IInspectable *sender, IInspectable *args );
+
+void event_handlers_invoke( struct event_handlers *list, CRITICAL_SECTION *cs, IInspectable *sender, IInspectable *args )
+{
+    IUnknown *handlers[MAX_EVENT_HANDLERS];
+    UINT i, count = 0;
+
+    EnterCriticalSection( cs );
+    for (i = 0; i < MAX_EVENT_HANDLERS; i++)
+        if (list->handler[i])
+        {
+            handlers[count] = list->handler[i];
+            IUnknown_AddRef( handlers[count] );
+            count++;
+        }
+    LeaveCriticalSection( cs );
+
+    for (i = 0; i < count; i++)
+    {
+        delegate_invoke invoke = ((delegate_invoke *)handlers[i]->lpVtbl)[3];
+        HRESULT hr = invoke( handlers[i], sender, args );
+        if (FAILED(hr)) WARN( "handler %p returned %#lx.\n", handlers[i], hr );
+        IUnknown_Release( handlers[i] );
+    }
+}
+
+void event_handlers_clear( struct event_handlers *list )
+{
+    UINT i;
+
+    for (i = 0; i < MAX_EVENT_HANDLERS; i++)
+    {
+        if (list->handler[i]) IUnknown_Release( list->handler[i] );
+        list->handler[i] = NULL;
+    }
+}
