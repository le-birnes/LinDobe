+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": media_source.cs");
+    if (FAILED(hr = WindowsDuplicateString( url, &impl->url )))
+    {
